[Icon Theme]
Name=Nordic Icons
Comment=Minimal thin-stroke Nordic tray, popup, System Settings, Dolphin, and dark-glass 64px file icons inheriting Breeze Dark
Inherits=breeze-dark
DisplayDepth=32
FollowsColorScheme=true
Directories=status/22,actions/22,apps/22,devices/22,preferences/22,categories/22,places/22,places/64,mimetypes/64,applets/22

[status/22]
Size=22
MinSize=16
MaxSize=64
Context=Status
Type=Scalable

[actions/22]
Size=22
MinSize=16
MaxSize=64
Context=Actions
Type=Scalable

[apps/22]
Size=22
MinSize=16
MaxSize=64
Context=Applications
Type=Scalable

[devices/22]
Size=22
MinSize=16
MaxSize=64
Context=Devices
Type=Scalable

[preferences/22]
Size=22
MinSize=16
MaxSize=64
Context=Categories
Type=Scalable

[categories/22]
Size=22
MinSize=16
MaxSize=64
Context=Categories
Type=Scalable

[places/22]
Size=22
MinSize=16
MaxSize=31
Context=Places
Type=Scalable

[places/64]
Size=64
MinSize=32
MaxSize=256
Context=Places
Type=Scalable

[mimetypes/64]
Size=64
MinSize=32
MaxSize=256
Context=MimeTypes
Type=Scalable

[applets/22]
Size=22
MinSize=16
MaxSize=64
Context=Status
Type=Scalable

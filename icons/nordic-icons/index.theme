[Icon Theme]
Name=Nordic Icons
Comment=Minimal thin-stroke Nordic tray and popup icon overlay inheriting Breeze Dark
Inherits=breeze-dark
DisplayDepth=32
FollowsColorScheme=true
Directories=status/22,actions/22,apps/22,devices/22,preferences/22,applets/22

[status/22]
Size=22
MinSize=16
MaxSize=64
Context=Status
Type=Scalable

[actions/22]
Size=22
MinSize=16
MaxSize=64
Context=Actions
Type=Scalable

[apps/22]
Size=22
MinSize=16
MaxSize=64
Context=Applications
Type=Scalable

[devices/22]
Size=22
MinSize=16
MaxSize=64
Context=Devices
Type=Scalable

[preferences/22]
Size=22
MinSize=16
MaxSize=64
Context=Categories
Type=Scalable

[applets/22]
Size=22
MinSize=16
MaxSize=64
Context=Status
Type=Scalable
